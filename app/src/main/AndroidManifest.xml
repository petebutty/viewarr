<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice search: the speech recogniser listens for Viewarr (asked for the first time the mic is pressed). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Puts Viewarr's Continue watching into the TV home screen's Watch Next row. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- So the home screen rows' refresh job comes back after the box restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- In-app updates (Settings → Updates): hands the downloaded APK to Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Voice search: Android's own speech recogniser (Google on most TVs) does the listening; Viewarr gets the words. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".TvApp"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:theme="@style/Theme.Viewarr">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- A Watch Next card on the TV home screen opens that title in Viewarr. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${linkScheme}" android:host="title" />
            </intent-filter>
            <!-- Home automation / ADB: viewarr://channel (uuid / number / step), stop, guide, page, record, search, refresh. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="${linkScheme}" android:host="channel" />
                <data android:scheme="${linkScheme}" android:host="stop" />
                <data android:scheme="${linkScheme}" android:host="guide" />
                <data android:scheme="${linkScheme}" android:host="page" />
                <data android:scheme="${linkScheme}" android:host="record" />
                <data android:scheme="${linkScheme}" android:host="search" />
                <data android:scheme="${linkScheme}" android:host="refresh" />
                <data android:scheme="${linkScheme}" android:host="homerows" />
                <data android:scheme="${linkScheme}" android:host="rows" />
            </intent-filter>
            <!-- The remote's mic / search button: Android sends a voice-search or assist request to the app set to take
                 it. With Viewarr chosen for these, the button opens Viewarr's voice search from anywhere (2026-11-20). -->
            <intent-filter>
                <action android:name="android.speech.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEARCH_LONG_PRESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver android:name=".data.update.InstallReceiver" android:exported="false" />
        <!-- Home screen rows (Settings → Live TV): refreshed every 15 minutes while Viewarr is closed. -->
        <!-- The home-screen rows' card pictures, for the launcher to read (channel logos on cards; nothing private). -->
        <provider android:name=".data.media.HomeRowArtProvider" android:authorities="${applicationId}.homerowart" android:exported="true" />
        <service android:name=".data.media.HomeRowsJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
    </application>
</manifest>
