<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice search: the speech recogniser listens for Viewarr (asked for the first time the mic is pressed). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Puts Viewarr's Continue watching into the TV home screen's Watch Next row. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- In-app updates (Settings → Updates): hands the downloaded APK to Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Voice search: Android's own speech recogniser (Google on most TVs) does the listening; Viewarr gets the words. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".TvApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:theme="@style/Theme.Viewarr">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- A Watch Next card on the TV home screen opens that title in Viewarr. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="viewarr" android:host="title" />
            </intent-filter>
        </activity>
        <receiver android:name=".data.update.InstallReceiver" android:exported="false" />
    </application>
</manifest>
