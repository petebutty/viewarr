<?xml version="1.0" encoding="utf-8"?>
<!-- Previewarr Mobile: turns upright or sideways as the phone or tablet is held (the TV builds are always sideways),
     and keeps music playing with the screen off or in another app (MobileMusicService, a media service with the
     usual notification and lock-screen controls). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Tablets: Play on TV listens in the background too (PlayOnTvService; phones only send). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application>
        <activity
            android:name=".MainActivity"
            android:screenOrientation="fullUser"
            tools:replace="android:screenOrientation" />
        <service
            android:name="io.github.petebutty.viewarr.playback.MobileMusicService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <service
            android:name="io.github.petebutty.viewarr.data.cast.PlayOnTvService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Receives Play on TV requests (play, pause, stop) from the user's own phone on the home network" />
        </service>
        <receiver android:name="io.github.petebutty.viewarr.data.cast.PlayOnTvBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
